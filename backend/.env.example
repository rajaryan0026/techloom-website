NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://techloom:techloom_secret@localhost:5432/techloom?schema=public

JWT_SECRET=change-me-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=change-me-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Production:
# FRONTEND_URL=https://www.techloom.live
# CORS_ORIGIN=https://www.techloom.live

# Production (Render): use Resend — Gmail SMTP times out on cloud hosts
# Replace re_xxxxxxxxx with your real key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Techloom <notifications@techloom.live>
CONTACT_EMAIL=your-email@gmail.com

# Local dev fallback (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_FALLBACK_NUMBER=+1234567890

AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=admin@techloom.com
ADMIN_PASSWORD=Admin@Techloom123